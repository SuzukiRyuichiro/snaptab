<div class="flex flex-col w-full gap-4 pb-20 pt-4">

  <div class="card bg-base-100 w-full shadow-sm">
    <div class="card-body">
      <div class=" flex justify-between">
        <h2 class="card-title">
          Category Breakdown
        </h2>
        <!-- TODO: make the content of the button synamic to the selected
        month.-->
        <div class="dropdown dropdown-end">
          <div tabindex="0" role="button" class="btn m-1">2026-June</div>
          <ul
            tabindex="-1"
            class="
              dropdown-content menu bg-base-100 rounded-box z-1 w-52 p-2 shadow-sm
            "
          >
            <!-- TODO: make the options only relevant month for the user. -->
            <!--TOOD: each option would be a linkto the same page but with the
            query param changed -->
            <li><a>Item 1</a></li>
            <li><a>Item 2</a></li>
          </ul>
        </div>
      </div>
      <div class="w-full">
        <%= pie_chart @category_breakdown, prefix: "¥", legend: false %>

        <div class="overflow-x-auto mt-4 text-xs">
          <table class="table w-full">
            <thead>
              <tr>
                <th>Category</th>
                <th class="text-right">Amount</th>
              </tr>
            </thead>
            <tbody>
              <% @category_breakdown.each do |category, amount| %>
                <tr>
                  <td class="flex items-center gap-2"><%= icon category, size: 4 %><%= category.titleize %></td>
                  <td class="text-right"><%= number_to_currency(amount, unit: "¥") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>

  <%= render "table", expenses: @expenses || [] %>

</div>
