<div class="w-full h-screen flex flex-col justify-center-safe">
  <div class="w-full">

    <div class="text-center">
      <h1 class="text-4xl font-bold"><%= t('expenses.new.title') %></h1>
      <h3 class="text-base-content/50"><%= t('expenses.new.description') %></h3>
    </div>

    <div class="mt-10 grid gap-10">
      <%= link_to "#", class: "grid py-10 btn btn-block h-auto btn-outline border-primary/10 place-items-center" do %>
        <div class=" bg-primary/10 w-20 h-20 grid place-items-center rounded-full ">
          <%= icon "camera", stroke_width: 2, size: 8 %>
        </div>
        <span class="text-xl font-semibold"><%= t('expenses.new.scan_receipt') %></span>
      <% end %>
      <button
        class="
          w-full grid py-10 btn btn-block h-auto btn-outline border-primary/10
          place-items-center
        "
        onclick="voiceInputModal.showModal()"
      >
        <div class=" bg-primary/10 w-20 h-20 grid place-items-center rounded-full ">
          <%= icon "microphone", stroke_width: 2, size: 8 %>
        </div>
        <span class="text-xl font-semibold"><%= t('expenses.new.voice_input') %></span>
      </button>
    </div>
    <!-- Voice input modal -->
    <dialog id="voiceInputModal" class="modal">
      <div
        class="modal-box"
        data-controller="audio-recorder"
        data-audio-recorder-start-label-value="<%= t('voice_memos.record.start') %>"
        data-audio-recorder-stop-label-value="<%= t('voice_memos.record.stop') %>"
        data-audio-recorder-recording-label-value="<%= t('voice_memos.record.recording') %>"
        data-audio-recorder-denied-label-value="<%= t('voice_memos.record.denied') %>"
      >
        <h3 class="text-lg font-bold"><%= t('voice_memos.record.title') %></h3>
        <p class="py-2 text-base-content/60"><%= t('voice_memos.record.hint') %></p>

        <%= form_with url: voice_memos_path, method: :post, multipart: true, data: { audio_recorder_target: "form" } do %>
          <%= file_field_tag :audio, accept: "audio/*", class: "hidden", data: { audio_recorder_target: "input" } %>
        <% end %>

        <button
          type="button"
          class="btn btn-primary btn-block mt-2"
          data-action="audio-recorder#toggle"
          data-audio-recorder-target="button"
        ><%= t('voice_memos.record.start') %></button>
        <p class="text-sm text-base-content/60 mt-2" data-audio-recorder-target="status"></p>

        <div class="modal-action">
          <form method="dialog">
            <button class="btn"><%= t('voice_memos.record.close') %></button>
          </form>
        </div>
      </div>
    </dialog>
  </div>
</div>
