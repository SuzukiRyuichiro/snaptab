<div
  class="overflow-x-auto rounded-box border border-base-content/5 bg-base-100"
>
  <table class="table">
    <!-- head -->
    <thead>
      <tr>
        <th>Date</th>
        <th>Description</th>
        <th>Amount</th>
        <th>Category</th>
      </tr>
    </thead>
    <tbody>
      <% expenses.each do |expense| %>
        <tr>
          <td><%= expense.spent_at %></td>
          <td class="whitespace-nowrap overflow-ellipsis min-w-16"><%= expense.description %></td>
          <td><%= expense.currency %><%= expense.amount %></td>
          <td class="flex gap-1 items-center text-primary/60 whitespace-nowrap"><%= render "category_icon", category: expense.category %><%= expense.category.display_name %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
