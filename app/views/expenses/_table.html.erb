<div
  class="overflow-x-auto rounded-box border border-base-content/5 bg-base-100"
>
  <table class="table">
    <% expenses_grouped_by_date.each do |date, expenses| %>
      <thead>
        <tr class="bg-base-200">
          <th><%= l date, format: :short %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% expenses.each do |expense| %>
          <tr>
            <td
              class="
                flex gap-1 items-center whitespace-nowrap overflow-ellipsis min-w-16
              "
            ><%= render "category_icon", category: expense.category %><%= expense.description %></td>
            <td class="text-right"><%= number_to_currency(expense.amount, unit: "¥", precision: 0) %></td>
          </tr>
        <% end %>
      </tbody>
    <% end %>
  </table>
</div>
